{
  "name": "sales-pipeline-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "check:tdz": "node scripts/check-tdz.mjs",
    "check:inline": "node scripts/check-inline-components.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:dupes": "node scripts/check-dupes.mjs",
    "check:dbfetch": "node scripts/scan-dbfetch.mjs",
    "test": "node --test",
    "test:int": "node --env-file-if-exists=.env --import tsx --test --experimental-test-module-mocks tests/integration/accounts.itest.mjs tests/integration/leads.itest.mjs tests/integration/contacts.itest.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.0.1",
    "@clerk/clerk-react": "^5.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@netlify/neon": "^0.1.2",
    "drizzle-orm": "^0.45.1",
    "pdfkit": "^0.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.3.1",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.22.4",
    "vite": "^5.4.2"
  }
}
